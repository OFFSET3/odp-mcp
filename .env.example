# USPTO Open Data Portal API key
# Obtain/manage at: https://data.uspto.gov/apikey
# In production this is injected from Azure Key Vault secret: kv-offset3/uspto-odp-api-key
USPTO_API_KEY=your_api_key_here

# Optional, separate credentials for non-ODP USPTO data products.
# Leave blank to use the ODP Patent File Wrapper fallback for patent search.
PATENTSVIEW_API_KEY=
# TSDR requires its own USPTO API Manager credential. The ODP key is not
# used as a fallback. In production, provision this separately before enabling
# odp_trademark_status.
USPTO_TSDR_API_KEY=

# Optional upstream overrides
PATENTSVIEW_BASE_URL=https://search.patentsview.org/api/v1/patent/
USPTO_ODP_APPLICATION_BASE_URL=https://api.uspto.gov/api/v1/patent/applications
USPTO_TSDR_BASE_URL=https://tsdrapi.uspto.gov/ts/cd

# Optional: override MCP server name shown to clients
MCP_SERVER_NAME=USPTO ODP

# Transport security (set true + allowed hosts when running behind a custom domain)
MCP_ENABLE_DNS_REBINDING_PROTECTION=false
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
